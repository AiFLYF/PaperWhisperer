# Required for model-backed analysis and Q&A.
OPENAI_API_KEY=sk-your-key

# OpenAI-compatible API endpoint and model name.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional deployment/version label exposed by /api/health.
PAPERWHISPERER_VERSION=0.9.0

# Paper search and recommendation defaults.
PAPER_SEARCH_ENABLE_REWRITE=true
PAPER_SEARCH_REWRITE_MODEL=
PAPER_SEARCH_RESULT_LIMIT=8
RECOMMENDATION_RESULT_LIMIT=6
# Query both arXiv and Semantic Scholar concurrently.
PAPER_SEARCH_PARALLEL=true

# Optional paper-source tuning.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_TIMEOUT_SECONDS=20
SEMANTIC_SCHOLAR_MAX_RETRIES=3
# Per-source backoff: retries, and the ceiling on the delay between them.
SEMANTIC_SCHOLAR_RETRY_MAX_DELAY=20
ARXIV_TIMEOUT_SECONDS=30
ARXIV_MAX_RETRIES=2
ARXIV_RETRY_MAX_DELAY=8
REMOTE_IMPORT_TIMEOUT_SECONDS=30

# Session persistence and cleanup.
SESSION_TTL_SECONDS=86400
SESSION_CLEANUP_INTERVAL_SECONDS=600
SESSION_PERSIST_FULL_DOCUMENT=true

# LLM runtime tuning.
OPENAI_MAX_CONCURRENCY=5
OPENAI_REQUEST_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3
# Output budget per response, in tokens (256-32768). This budget is shared with
# the model's reasoning: a reasoning model that spends the whole allowance
# thinking returns EMPTY content, not a shortened answer. The default leaves
# room to reason and still enough to emit a full section, but if you point this
# at a reasoning model, raise it.
OPENAI_LLM_MAX_TOKENS=8000

# FastAPI/Uvicorn runtime (preferred).
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=5000
FASTAPI_RELOAD=false

# Document ingestion limits.
# MAX_UPLOAD_BYTES: per-file upload/download ceiling in bytes (1MB-512MB).
# Also the limit enforced on the remote-import path, so one value covers every
# ingress. MAX_CONTENT_LENGTH is a legacy alias of this and always tracks it.
MAX_UPLOAD_BYTES=16777216
# MAX_DOCUMENT_PAGES: the page ceiling an operator may set (1-5000). NOT YET
# ENFORCED -- the parser gateway does not refuse an oversized document yet, so
# this value is currently only reported by /api/health. Do not rely on it as a
# resource guard until the gateway check lands.
MAX_DOCUMENT_PAGES=400

# Parser gateway. PARSER_BACKEND is the feature flag: legacy or gateway.
# An unrecognised value is NOT honoured; it falls back to legacy and is logged.
PARSER_BACKEND=legacy
# PARSER_PRIMARY: parser tried first. Built-ins are legacy, docling, mineru.
PARSER_PRIMARY=docling
# PARSER_FALLBACK_CHAIN: comma-separated parsers to try in order. Empty = no fallback.
PARSER_FALLBACK_CHAIN=
# PARSER_TIMEOUT_SECONDS: per-parser wall-clock budget (5-1800).
PARSER_TIMEOUT_SECONDS=120
# PARSER_FORCE_OCR: force OCR even on text-native PDFs (local repair retry).
PARSER_FORCE_OCR=false
# PARSER_CACHE_ENABLED: cache hits keyed on (sha256, parser, version, options).
PARSER_CACHE_ENABLED=true
# PARSER_CACHE_DIR: empty means context/parse_cache.
PARSER_CACHE_DIR=
# PARSER_ARTIFACT_DIR: where raw parser output is written for offline repro.
PARSER_ARTIFACT_DIR=context/parser_artifacts

# Parse quality gate (T0.6). Every threshold is OPTIONAL and commented out on
# purpose: the authoritative default lives in the rule code
# (ingestion/quality.QualityThresholds), so an uncommented value would pin the
# library default at the moment you copied this file. Unset = that default.
# A value that is not a number, or is out of range, is refused with a warning
# and the library default stays in force.
#PARSER_QUALITY_MIN_PAGE_COVERAGE_RATIO=0.9
#PARSER_QUALITY_MAX_BLANK_PAGE_RATIO=0.2
#PARSER_QUALITY_MAX_GARBLED_CHAR_RATIO=0.01
#PARSER_QUALITY_MAX_FRAGMENTED_LINE_RATIO=0.3
#PARSER_QUALITY_MAX_FRAGMENT_LINE_CHARS=3
#PARSER_QUALITY_MIN_LINES_FOR_RATIO=10
#PARSER_QUALITY_MIN_FURNITURE_REPEAT_COUNT=3
#PARSER_QUALITY_MIN_CHARS_PER_PAGE=200
#PARSER_QUALITY_MIN_DOCUMENT_CHARS=200
#PARSER_QUALITY_MAX_EMPTY_TABLE_RATIO=0.5
#PARSER_QUALITY_MIN_RESOLVABLE_LOCATOR_RATIO=1.0
# Per-rule severity policy, "rule_id=warn|fail", comma separated. Valid rule
# ids: page_coverage, blank_page_ratio, garbled_characters, fragmented_lines,
# repeated_furniture, text_density, empty_table_shells, locator_coverage.
# An entry can re-level a rule; it can never make a rule fire that would
# otherwise have stayed silent. Unknown ids are ignored.
#PARSER_QUALITY_SEVERITY_OVERRIDES=blank_page_ratio=warn

# Docling adapter. Mode is inprocess or serve; serve URL is only read in serve mode.
# docling is NOT a base dependency: pip install ".[parse]" to use it at all.
PARSER_DOCLING_MODE=inprocess
# Must be http(s); anything else is rejected and the default is used.
PARSER_DOCLING_SERVE_URL=http://localhost:5001

# Document privacy. local_only forbids all cloud egress; allow_cloud still needs consent.
# The safe default is local_only: cloud parsing must be opted into twice, here and
# per user in DOCUMENT_CLOUD_CONSENT_GRANTED / the request payload.
DOCUMENT_PRIVACY_MODE=local_only
DOCUMENT_CLOUD_CONSENT_GRANTED=false

# MinerU cloud parser. Leave the token empty to keep cloud parsing disabled.
# The token is never logged and describe_parser_settings() only reports whether
# one is configured.
MINERU_API_TOKEN=
# Must be http(s); anything else is rejected and the default is used.
MINERU_API_BASE_URL=https://mineru.net
# Per-request HTTP timeout (5-600).
MINERU_TIMEOUT_SECONDS=60
# Retries for 429/timeout/5xx. An exhausted quota is NOT retried (see T0.5).
MINERU_MAX_RETRIES=3
# Job polling cadence (1-60) and total polling budget (30-3600), in seconds.
MINERU_POLL_INTERVAL_SECONDS=5
MINERU_POLL_TIMEOUT_SECONDS=900
# Cloud parsing is billed per call, so cap it: 0 = no daily limit, and 1 task at
# a time by default. T0.5's degradation path uses these to tell an exhausted
# quota (do not retry) from a transient 429 (do retry).
MINERU_DAILY_CALL_LIMIT=0
MINERU_MAX_CONCURRENT_TASKS=1

# Embedding / rerank (P1). Embedding base URL falls back to OPENAI_BASE_URL when empty.
EMBEDDING_API_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# Changing the model means changing the dimension and rebuilding the index.
EMBEDDING_DIMENSION=1536
# Provider name. Encoded into index_version alongside model+dim, so a provider
# switch requires an index rebuild rather than mixing vectors from two backends.
# Open value: self-hosted services name themselves freely.
EMBEDDING_PROVIDER=openai_compatible
# Texts per embedding request (1-2048). Larger batches cut request count;
# smaller ones shrink the blast radius of a single timeout.
EMBEDDING_BATCH_SIZE=64
# In-flight embedding requests (1-64). Kept below OPENAI_MAX_CONCURRENCY (5)
# because a full index rebuild fans out hard.
EMBEDDING_MAX_CONCURRENCY=4
# Retries for a failed embedding request (1-10).
EMBEDDING_MAX_RETRIES=3
# Per-request embedding HTTP timeout in seconds (1-600).
EMBEDDING_REQUEST_TIMEOUT_SECONDS=60
# Process-local LRU entries, keyed on (model, content_hash). This number is
# also the memory ceiling, so raising it raises resident memory linearly.
EMBEDDING_MAX_CACHE_ENTRIES=4096
# Price per million tokens, recorded into analysis_run cost. Leave EMPTY when the
# price is unknown -- that is recorded as "unknown", which is not the same claim
# as 0 ("free"). A non-number or an out-of-range value is refused with a warning.
#EMBEDDING_PRICE_PER_MTOK=

# Local embedding provider -- OPTIONAL EXTRA, OFF BY DEFAULT.
#
# The default and intended path is the OpenAI-compatible endpoint above: that is
# decision D3 in the development plan, which specifies API providers for
# LLM/embedding/rerank and explicitly not a local BGE-M3. Nothing below changes
# that unless you set EMBEDDING_LOCAL_ENABLED=1.
#
# What it is for: a deployment with no network and no API key (a supported
# personal-tier configuration, not a degraded one); a test that has to exercise
# the real embedding chain offline; and a bake-off comparing two providers over
# one document. Install it with `pip install -e ".[local-embeddings]"` -- the
# base install does not carry ONNX Runtime and never imports it.
#
# Turning it on rewrites EMBEDDING_PROVIDER / EMBEDDING_MODEL / EMBEDDING_DIMENSION
# to the values below, so EMBEDDING_MODEL= and EMBEDDING_DIMENSION= above are
# ignored while it is on. That rewrite is what puts the local model into
# index_version, and therefore what forces an index rebuild on a provider switch.
#EMBEDDING_LOCAL_ENABLED=0
# Model name, written into index_version. The default is a multilingual MiniLM
# rather than an English-only model because this corpus is bilingual; an
# English-only model returns near-identical vectors for a Chinese query, which
# is the "dense leg has no discrimination" case the retriever detects and
# abstains from.
#EMBEDDING_LOCAL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Declared vector width. Verified against fastembed's own registry when the
# provider is constructed, and a disagreement is refused with the correct number
# in the message rather than producing vectors the search path cannot compare.
# If you change the model above, change this too.
#EMBEDDING_LOCAL_DIMENSION=384
# Where ONNX weights are cached. Empty uses fastembed's default location. Set
# it to pre-seed the download in a deployment script, or in a container with no
# writable HOME. First use downloads a few hundred MB.
#EMBEDDING_LOCAL_MODEL_DIR=
# ONNX Runtime threads. 0 lets fastembed decide; only worth setting when CPU
# affinity is wrong on a many-core machine. 0-64.
#EMBEDDING_LOCAL_THREADS=0
# Set to 1 for a model that needs different query and passage prefixes (E5, Jina,
# GTE). The default model needs none, so this stays 0.
#EMBEDDING_LOCAL_ASYMMETRIC=0

# RAG chunking. Chunks longer than this are split; too short and a retrieved
# passage stops carrying enough context to be quotable.
RAG_CHUNK_MAX_TOKENS=512

# Bibliographic enrichment (Crossref / OpenAlex). Both addresses must be
# http(s); anything else is rejected and the default is used.
CROSSREF_API_URL=https://api.crossref.org/works
OPENALEX_API_URL=https://api.openalex.org/works
# Crossref polite-pool contact. Both upstreams rate-limit harder for anonymous
# clients; a real address gets you into a more generous pool.
ENRICHMENT_CONTACT_EMAIL=

# Storage backend. sqlite is the personal tier; postgres is the hosted tier.
# An unrecognised value is NOT honoured: it falls back to sqlite and is logged.
STORAGE_BACKEND=sqlite
# SQLite file. Relative paths resolve against the project root.
STORAGE_SQLITE_PATH=context/stores/paperwhisperer.sqlite3
# Seconds to wait on the SQLite write lock (1-600). Raise it if a heavy index
# write trips "database is locked" under a job worker.
STORAGE_SQLITE_TIMEOUT_SECONDS=30
# Full-text search: auto probes the build for FTS5, on requires it, off uses LIKE.
STORAGE_LEXICAL_FTS5=auto
# Postgres connection string. Leave empty for a SQLite deployment. When empty the
# app also tries PAPERWHISPERER_PG_DSN, DATABASE_URL, then POSTGRES_DSN, in that
# order -- this variable simply takes precedence over all three.
STORAGE_PG_DSN=
# Schema holding the tables, and the connect timeout in seconds (1-120).
STORAGE_PG_SCHEMA=public
STORAGE_PG_CONNECT_TIMEOUT_SECONDS=5
# Approximate nearest-neighbour search. Off by default: exact scan first, and
# enabling this requires pgvector to be installed in the target database.
STORAGE_PG_ANN=false

# Rerank stays off until retrieval eval says otherwise.
RERANK_ENABLED=false
RERANK_MODEL=

# Legacy Flask runtime vars (fallback compatibility during migration).
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# --- 后台任务（T2.1 paperwhisperer/infra/jobs.py）---
# 长任务移出 API 请求生命周期：解析/索引/分析走 job 表驱动，worker 在进程内轮询。
JOBS_ENABLED=true
# worker 空转轮询间隔（秒）。
JOBS_POLL_INTERVAL_SECONDS=1
# 租约时长（秒）。worker 在每个可取消边界续租；超过此时长没有续租的任务
# 会被下一个 worker 回收。单步耗时超过它时，步骤必须调用 ctx.heartbeat()，
# 否则一个正常但缓慢的步骤会被误判为崩溃并重复执行。
JOBS_LEASE_SECONDS=300
# 失败重试上限。用尽后任务进入 failed 且 retryable=True，可由 retry() 显式重投。
JOBS_MAX_ATTEMPTS=3
# 留空表示按主机名自动生成；多实例部署时建议显式区分。
JOBS_WORKER_ID=
# 已终结任务的保留天数，超期由清理扫描删除。
JOBS_RETENTION_DAYS=14

# --- 证据页图渲染（T3.3）---
# 装了 `render` extra（pip install -e ".[render]"）之后，证据面板可以显示 PDF
# 页面的真实渲染图。没装也能跑：证据路由回 501，payload 的 page_image.renderer
# 读作 "none"，前端继续用 view 里的坐标重建布局。
#
# 缩放，即每个 PDF 点对应多少设备像素。默认 2.0（144 DPI），双栏论文正文在
# 600px 宽的面板里刚好可读。这个值同时写进 payload，客户端不需要自己算。
PAGE_RENDER_SCALE=2.0
# 允许请求的最大缩放。本项目里唯一一处「请求可以按线上数字分配图像」的地方：
# A0 海报按 64 渲染约 2.56 亿像素。上限定得让 3x 屏拿到 3 倍图，又让最坏情况
# 是一张大图而不是进程被杀。超出会被钳制到上限，不会 400。
PAGE_RENDER_MAX_SCALE=4.0
# 页图渲染的进程内缓存上限。渲染不便宜，但个人档是长驻进程，无界缓存就是
# 内存泄漏，所以条目数和字节数两个上限同时生效，条目数或字节数先到就先淘汰。
# 缓存键是「原始文件摘要 + 页码 + 缩放」而不是 document_id：页图是原始字节的
# 函数，重新解析（document_id 不变、版本变）既不会让它失效也不会让它过期。
PAGE_RENDER_CACHE_MAX_ENTRIES=64
PAGE_RENDER_CACHE_MAX_BYTES=33554432
# 对象存储根目录，T2.2 的 original 层在这里面。页图渲染按文档记录的 sha256
# 到这一层按内容寻址找原始字节（算术，不是目录扫描）。
#
# 注意：目前还没有任何代码把上传写进这一层，而且 /api/analyze 会在分析结束后
# 删除临时上传文件。所以这一项在 T2.2 把 original 层接上之前是「配了也没有
# 东西可找」的——路由会明确报 reason=original_unavailable，而不是渲染一张空图。
# 过渡期如果把原始文件放在别处并在文档记录的 metadata.original_path 里写上
# 路径，路由会把它当兜底方案使用。
PAGE_RENDER_ORIGINALS_DIR=context/objects
