# Required for model-backed analysis and Q&A.
OPENAI_API_KEY=sk-your-key

# OpenAI-compatible API endpoint and model name.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# When true, manual paper-search queries are rewritten into academic search phrases before querying sources.
PAPER_SEARCH_ENABLE_REWRITE=true
PAPER_SEARCH_REWRITE_MODEL=gpt-4o-mini

# Optional Semantic Scholar key and retry budget for rate-limited search responses.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_MAX_RETRIES=3

# Keep false for privacy; set true only if full-document persistence is needed across session reloads.
SESSION_PERSIST_FULL_DOCUMENT=false

# LLM runtime tuning.
OPENAI_MAX_CONCURRENCY=5
OPENAI_REQUEST_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3

# FastAPI/Uvicorn runtime (preferred).
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=5000
FASTAPI_RELOAD=false

# Legacy Flask runtime vars (fallback compatibility during migration).
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
