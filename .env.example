# Required for model-backed analysis and Q&A.
OPENAI_API_KEY=sk-your-key

# OpenAI-compatible API endpoint and model name.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional deployment/version label exposed by /api/health.
PAPERWHISPERER_VERSION=0.9.0

# Paper search and recommendation defaults.
PAPER_SEARCH_ENABLE_REWRITE=true
PAPER_SEARCH_REWRITE_MODEL=
PAPER_SEARCH_RESULT_LIMIT=8
RECOMMENDATION_RESULT_LIMIT=6

# Optional paper-source tuning.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_TIMEOUT_SECONDS=20
SEMANTIC_SCHOLAR_MAX_RETRIES=3
REMOTE_IMPORT_TIMEOUT_SECONDS=30

# Session persistence and cleanup.
SESSION_TTL_SECONDS=86400
SESSION_CLEANUP_INTERVAL_SECONDS=600
SESSION_PERSIST_FULL_DOCUMENT=false

# LLM runtime tuning.
OPENAI_MAX_CONCURRENCY=5
OPENAI_REQUEST_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3

# FastAPI/Uvicorn runtime (preferred).
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=5000
FASTAPI_RELOAD=false

# Legacy Flask runtime vars (fallback compatibility during migration).
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
